// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`runAgent (Postgres) > request tools are unchanged 1`] = `"[{"type":"custom","name":"list_fleet","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{},"additionalProperties":false},"description":"The operator's fleet: every vessel with its IMO number, ship type and current voyage (voyage number and status). Returns citable facts per vessel."},{"type":"custom","name":"get_vessel_status","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"vessel":{"type":"string","minLength":1,"description":"Vessel name (e.g. \\"Aegean Pioneer\\") or 7-digit IMO."}},"required":["vessel"],"additionalProperties":false},"description":"Fuel status of one fleet vessel: remaining on board per grade from the latest noon report, the fuel-on-board projection for the rest of the current voyage (fuel needed, safety margin, shortfall per grade), and the next port call with its ETA. Returns citable facts."},{"type":"custom","name":"list_quotes","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"vessel":{"type":"string","minLength":1,"description":"Vessel name (e.g. \\"Aegean Pioneer\\") or 7-digit IMO."},"port":{"description":"Port name or 5-letter UN/LOCODE.","$ref":"#/$defs/__schema0"},"grade":{"type":"string","enum":["LSMGO","VLSFO","HSFO"]},"includeExpired":{"description":"Also return quotes past their validity. Default false.","$ref":"#/$defs/__schema1"}},"additionalProperties":false,"$defs":{"__schema0":{"type":"string","minLength":1},"__schema1":{"type":"boolean"}}},"description":"Supplier quotes on record, optionally for one vessel's voyages, one port or one fuel grade: supplier, port, status, validity, barge fee, and per fuel grade the quantity offered and the price per mt in the quote currency (and in USD for a non-USD quote). Expired quotes are left out unless includeExpired is true. Returns citable facts per quote and per grade."},{"type":"custom","name":"plan_bunkering","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"vessel":{"description":"Vessel name (e.g. \\"Aegean Pioneer\\") or 7-digit IMO. Omit it to plan every vessel with an open requirement.","$ref":"#/$defs/__schema0"}},"additionalProperties":false,"$defs":{"__schema0":{"type":"string","minLength":1,"description":"Vessel name (e.g. \\"Aegean Pioneer\\") or 7-digit IMO."}}},"description":"Bunker plans for open fuel requirements: one plan per open requirement (per grade) of a vessel's current voyage, or of every vessel's when no vessel is given. Each plan ranks every received, still-valid supplier quote by total delivered cost (fuel, barge fee, deviation, delay, EU ETS cost and FuelEU Maritime exposure) and checks feasibility (quantity, tank space, safety margin, berth window), on the vessel's consumption at its current load (displacement). Each plan is stored as a calculation; the result gives each plan's calculationId, best option and citable facts per option (with several plans, a plans or vessels list)."},{"type":"custom","name":"get_emissions","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"vessel":{"type":"string","minLength":1,"description":"Vessel name (e.g. \\"Aegean Pioneer\\") or 7-digit IMO."}},"required":["vessel"],"additionalProperties":false},"description":"Emissions of a vessel's current voyage: CO₂ from the fuel still to burn, the EU ETS cost of it (EUR and USD, with coverage and phase-in), and the CII rating of the voyage as planned (attained and required CII). Stores the result as a calculation; returns citable facts."},{"type":"custom","name":"plan_route_speed","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"vessel":{"type":"string","minLength":1,"description":"Fleet vessel name or IMO, or a ship seen on AIS by name or 9-digit MMSI."},"destination":{"description":"Port name or UN/LOCODE. Required for a ship that is not in the fleet.","$ref":"#/$defs/__schema0"}},"required":["vessel"],"additionalProperties":false,"$defs":{"__schema0":{"type":"string","minLength":1}}},"description":"Plan route and speed for a vessel: the fleet vessel's current voyage, or a ship seen on AIS (by name or 9-digit MMSI) sailing to a destination you name. Compares the planned or reported route and speed with up to two sea routes, using the latest weather forecast and reported hazards, and returns per route the distance, recommended speed, ETA, fuel, CO2, FuelEU Maritime exposure, total cost and weather delay, plus the saving against the current plan, and the load the fuel figures assume (displacement and load factor; for a ship seen on AIS, its reported draught and the load condition taken from it). Returns citable facts. Advice only: nothing is ordered or sent."},{"type":"custom","name":"get_port_congestion","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"port":{"type":"string","minLength":1,"description":"Port name or 5-letter UN/LOCODE."}},"required":["port"],"additionalProperties":false},"description":"Latest congestion at a port: vessels at anchor and expected waiting time, with when and from what source it was observed. The figures are observed at the anchorage (AIS) and can differ from the desk's planning figures, which bunker plans use. Returns citable facts."},{"type":"custom","name":"calculate","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"op":{"$ref":"#/$defs/__schema0"},"operands":{"$ref":"#/$defs/__schema1"}},"required":["op","operands"],"additionalProperties":false,"$defs":{"__schema0":{"type":"string","enum":["add","subtract","multiply","divide","difference","percent_change","sum","min","max"]},"__schema1":{"minItems":1,"maxItems":10,"type":"array","items":{"$ref":"#/$defs/__schema2"},"description":"Ids of facts returned earlier in this conversation, never typed numbers."},"__schema2":{"type":"string","pattern":"^f_[A-Za-z0-9_.:-]+$"}}},"description":"Arithmetic over facts returned earlier in this conversation, for any sum, difference, ratio or percentage the operator asks for. Pass the operation and the operand fact ids (never typed numbers); subtract is a - b, divide a / b, difference |a - b|, percent_change (b - a) / a in %. Units must agree for add, subtract, difference, sum, min and max. A percentage difference is one percent_change call: cite the fact it returns and do not also divide. Returns one derived fact to cite."},{"type":"custom","name":"propose_action","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"type":{"type":"string","enum":["purchase_order","voyage_instruction"],"description":"purchase_order for a bunker plan option; voyage_instruction for a route plan's route."},"calculationId":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991,"description":"The calculationId a plan_bunkering (purchase_order) or plan_route_speed (voyage_instruction) result returned."},"optionId":{"type":"string","minLength":1,"description":"A bunker plan's optionId (e.g. its bestOptionId), or a route plan's route id (e.g. its bestCandidateId)."},"factRefs":{"minItems":1,"type":"array","items":{"$ref":"#/$defs/__schema0"},"description":"Ids of the facts, returned earlier in this conversation, that support the proposal."},"rationale":{"type":"string","minLength":1,"description":"One sentence on why, without numbers."}},"required":["type","calculationId","optionId","factRefs","rationale"],"additionalProperties":false,"$defs":{"__schema0":{"type":"string","pattern":"^f_[A-Za-z0-9_.:-]+$"}}},"description":"Propose an action for a human to approve: a purchase order (type purchase_order) for one feasible option of a stored bunker plan, or a voyage instruction (type voyage_instruction) for one feasible route of a stored route plan of a fleet vessel. Use it only when the operator asks you to decide (where or from whom to buy, which offer to take, a recommendation or an order) or to instruct the master (prepare or issue the voyage instruction, put the route and speed into effect), never when they only look something up, compare, ask which route or speed is best, ask for a calculation or say not to order or instruct yet. Never for a ship seen on AIS. Creates a pending recommendation only: nothing is ordered, changed or sent. Takes the plan's calculationId and optionId (a bunker plan's optionId, or a route plan's route id), and factRefs that are facts of that same plan; quantities, prices, speeds and ETAs come from the stored plan, never from you."}]"`;
