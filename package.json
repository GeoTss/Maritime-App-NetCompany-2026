{
  "name": "pharos",
  "private": true,
  "type": "module",
  "description": "Smart Maritime Operations Assistant — Bunker-to-Berth",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "eval:smoke": "tsx evals/smoke/run.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:purity": "node scripts/check-domain-purity.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:purity && npm run test",
    "dev:api": "npm run dev -w @pharos/api",
    "dev:erp": "npm run dev -w @pharos/erp-sim",
    "smoke:pdf": "tsx scripts/pdf-smoke.ts",
    "db:generate": "npm run db:generate -w @pharos/db",
    "db:migrate": "npm run db:migrate -w @pharos/db",
    "db:seed": "npm run db:seed -w @pharos/db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22.10.0",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
