# Copy to .env and fill in. Never commit .env.
# Without a .env, `docker compose up --build` runs the recorded demo: recorded model replies, recorded
# AIS and weather, the world pinned to 2026-11-14T08:00Z. `npm run demo:live` goes live (needs both keys);
# `npm run demo:reset` goes back to recorded.

# --- Keys (only for live mode) ---
# Anthropic API key. Required when LLM_MODE is live or record.
ANTHROPIC_API_KEY=
# Free key from aisstream.io. Without it live AIS falls back to the recorded capture.
AISSTREAM_API_KEY=

# live | record | replay  (replay needs no key; compose defaults to replay)
LLM_MODE=replay

# --- Live data switches (set by npm run demo:live / demo:reset; shown here for reference only) ---
# Leave these commented: a blank DEMO_ANCHOR= line would unpin the recorded demo and every replay would miss.
# AIS_MODE: live | replay | off (worker; default replay)
# WEATHER_MODE: live | recorded (worker; default recorded)
# DEMO_HAZARDS: on | off — the labelled synthetic hazard with live AIS (default on)
# DEMO_ANCHOR: ISO instant the demo world is pinned to (default 2026-11-14T08:00:00Z; empty = wall clock)

# --- Local defaults (Docker Compose sets these for containers) ---
DATABASE_URL=postgres://pharos:pharos@localhost:5432/pharos
API_PORT=4000
ERP_PORT=4100
ERP_BASE_URL=http://localhost:4100

# --- Synthetic world (Phase 1) ---
# What the API does at boot: reset (wipe and reseed, anchored to boot time) | if-empty | off.
# Compose defaults to reset; a bare `npm run dev:api` defaults to if-empty.
SEED_ON_BOOT=
WORLD_SEED=20261114

# --- Models (Phase 2) — blank uses the app default ---
# Default model for both prompts is claude-haiku-5-5 (lowest cost); e.g. AGENT_MODEL=claude-opus-5-5.
EXTRACT_MODEL=
AGENT_MODEL=
# low | medium | high | xhigh | max (default medium)
EXTRACT_EFFORT=
AGENT_EFFORT=
# on | off — server-side refusal fallbacks (default off; Haiku 5.5 has none)
LLM_FALLBACKS=
