# Copy to .env and fill in. Never commit .env.

# --- Needed from Phase 2 (walking skeleton) ---
# Anthropic API key. Required when LLM_MODE is live or record.
ANTHROPIC_API_KEY=

# live | record | replay  (replay needs no key)
LLM_MODE=replay

# --- Needed from Phase 5 (live AIS) ---
# Free key from aisstream.io
AISSTREAM_API_KEY=

# --- Local defaults (Docker Compose sets these for containers) ---
DATABASE_URL=postgres://pharos:pharos@localhost:5432/pharos
API_PORT=4000
ERP_PORT=4100
ERP_BASE_URL=http://localhost:4100
